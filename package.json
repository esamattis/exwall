{
    "name": "exwall-ui",
    "private": true,
    "type": "module",
    "imports": {
        "#playwright_helpers/*": "./tests/playwright_helpers/*"
    },
    "scripts": {
        "dev": "vite ./ui",
        "build:ui": "pnpm types && vite build ./ui",
        "build": "pnpm build:ui && cargo build --locked",
        "types": "tsc -p tsconfig.json",
        "lint": "oxlint --type-aware --deny-warnings ui tests/playwright_helpers playwright.e2e.config.ts scripts",
        "lint:fix": "pnpm lint --fix",
        "format": "oxfmt --write ui package.json tsconfig.json .oxlintrc.json .oxfmtrc.json playwright.e2e.config.ts tests/playwright_helpers scripts",
        "format:check": "oxfmt --check ui package.json tsconfig.json .oxlintrc.json .oxfmtrc.json playwright.e2e.config.ts tests/playwright_helpers scripts",
        "check": "pnpm types && pnpm lint && pnpm format:check",
        "test:e2e": "node tests/playwright_helpers/run_e2e.mts"
    },
    "dependencies": {
        "@tanstack/react-query": "5.104.1",
        "@tanstack/react-router": "1.170.41",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "zx": "^8.8.5"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "4.3.3",
        "@types/node": "26.6.4",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "oxfmt": "0.72.0",
        "oxlint": "1.87.0",
        "oxlint-tsgolint": "7.0.2003",
        "tailwindcss": "4.3.3",
        "typescript": "7.0.2",
        "vite": "8.3.3"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "26.10.0",
            "onFail": "download"
        }
    },
    "packageManager": "pnpm@12.9.1"
}
