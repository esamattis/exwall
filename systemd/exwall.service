[Unit]
Description=Rama transparent HTTP(S) and DNS egress firewall
Wants=network-online.target
After=network-online.target systemd-resolved.service
BindsTo=systemd-resolved.service
PartOf=systemd-resolved.service

[Service]
Type=simple
User=exwall
Group=exwall
LogsDirectory=exwall
LogsDirectoryMode=0700
ExecStartPre=+/usr/local/bin/exwall hook guard
ExecStartPre=+/usr/local/bin/exwall hook start
ExecStart=/usr/local/bin/exwall serve
ExecReload=/bin/kill -HUP $MAINPID
# Every stop, including failed starts and crashes, removes enforcement and
# restores the original resolver and sysctls. ExecStopPost also runs when an
# ExecStartPre command fails, so a partial start is always cleaned up.
ExecStopPost=+/usr/local/bin/exwall hook stop
Restart=on-failure
RestartSec=2
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=multi-user.target
